# ═══════════════════════════════════════════════════════════
# Pramedha Career Template — Git Ignore Configuration
# ═══════════════════════════════════════════════════════════

# Generated files (auto-built by tools/resume/assemble.py + RenderCV)
tools/resume/generated/*
!tools/resume/generated/.gitkeep
tools/resume/output/*
!tools/resume/output/.gitkeep

# External tools sandbox (user-installed tools/clones, not tracked)
tools/external/*
!tools/external/.gitkeep
!tools/external/README.md

# Heavy video files in data-corpus (host on YouTube/Loom/Drive or use Git LFS)
data-corpus/media/*.mp4
data-corpus/media/*.mov
data-corpus/media/*.avi
data-corpus/media/*.mkv

# ═══════════════════════════════════════════════════════════
# PUBLIC REPOSITORY SAFETY OVERRIDE (Optional)
#
# ⚠️ This repository is designed to be PRIVATE.
# If you must host this on a PUBLIC repository, uncomment the lines below
# to exclude personal/confidential files from version control:
# ═══════════════════════════════════════════════════════════
# personal/
# strategy/financial.md
# strategy/networking.md
# identity/references.yaml
# personal/form-fill-cheatsheet.md
# journal/feedback.md
# data-corpus/

# ═══════════════════════════════════════════════════════════
# SECRETS & CREDENTIALS (NEVER commit, even to private repos)
# ═══════════════════════════════════════════════════════════
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*
credentials.json
client_secret*.json
token.json

# ═══════════════════════════════════════════════════════════
# PYTHON
# ═══════════════════════════════════════════════════════════
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Linting Caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ═══════════════════════════════════════════════════════════
# NODE / WEB TOOLING
# ═══════════════════════════════════════════════════════════
node_modules/
.npm
.next/
.turbo/
.nuxt/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ═══════════════════════════════════════════════════════════
# OPERATING SYSTEM
# ═══════════════════════════════════════════════════════════
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
[Tt]humbs.db
[Tt]humbs.db:encryptable
desktop.ini
$RECYCLE.BIN/

# ═══════════════════════════════════════════════════════════
# IDEs & EDITORS
# ═══════════════════════════════════════════════════════════
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project
.cursor/
.claude/

# ═══════════════════════════════════════════════════════════
# TEMPORARY & BACKUP FILES
# ═══════════════════════════════════════════════════════════
tmp/
temp/
*.bak
*.tmp
*.orig
*~
