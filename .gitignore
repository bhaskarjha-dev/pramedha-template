# ═══════════════════════════════════════════════════════════
# Pramedha Career Template — Git Ignore Configuration
# ═══════════════════════════════════════════════════════════

# Generated files (auto-built by tools/resume/assemble.py + RenderCV)
tools/resume/generated/
tools/resume/output/
rendercv_output/
tools/resume/rendercv_output/
*.synctex.gz
*.fls
*.fdb_latexmk

# External tools sandbox (user-installed tools/clones, not tracked)
tools/external/*
!tools/external/.gitkeep
!tools/external/README.md


# Heavy video files in data-corpus (host on YouTube/Loom/Drive or use Git LFS)
data-corpus/media/*.mp4
data-corpus/media/*.mov
data-corpus/media/*.avi
data-corpus/media/*.mkv


# ═══════════════════════════════════════════════════════════
# SECRETS & CREDENTIALS (NEVER commit, even to private repos)
# ═══════════════════════════════════════════════════════════
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*
credentials.json
client_secret*.json
token.json

