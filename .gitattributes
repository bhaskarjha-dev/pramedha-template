# Git LFS (Large File Storage) tracking for data-corpus/
# Standard documents (PDFs, DOCX, images <100MB) are tracked directly by Git.
# If you store large demo recordings or want Git LFS for binary files, uncomment below:
# data-corpus/media/*.mp4 filter=lfs diff=lfs merge=lfs -text
# data-corpus/media/*.mov filter=lfs diff=lfs merge=lfs -text
# data-corpus/resumes/*.pdf filter=lfs diff=lfs merge=lfs -text
# data-corpus/documents/*.pdf filter=lfs diff=lfs merge=lfs -text

# Ensure consistent line endings across platforms
* text=auto
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf

# Mark generated files as generated (GitHub diffs collapse them)
tools/resume/generated/** linguist-generated=true
